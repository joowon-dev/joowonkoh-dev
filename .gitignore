# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# superpowers
.superpowers/

# oh-my-claudecode
.omc/

# claude local settings
.claude/settings.local.json

# gsc-inspect (서비스 계정 키 + 결과 스냅샷)
scripts/.gsc-key.json
scripts/.gsc-results/

# mediapipe wasm 런타임 (빌드 때 node_modules에서 복사 — scripts/copy-mediapipe.mjs)
public/mediapipe/*.wasm
public/mediapipe/*_internal.js
